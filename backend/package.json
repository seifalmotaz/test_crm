{
  "name": "propcrm-backend",
  "version": "1.0.0",
  "description": "Real Estate CRM – Production Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint src/",
    "test": "jest --runInBand --forceExit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && node prisma/seed.js",
    "db:tune-vacuum": "node scripts/tune-autovacuum.js",
    "maintenance:vacuum": "node -e \"require('./src/maintenance/vacuum').runNightlyVacuum().then(r=>console.log(JSON.stringify(r,null,2)))\"",
    "maintenance:bloat": "node -e \"require('./src/maintenance/vacuum').getBloatReport().then(r=>console.log(JSON.stringify(r.tables,null,2)))\"",
    "maintenance:index-health": "node -e \"require('./src/maintenance/reindex').getIndexHealth().then(r=>console.log(JSON.stringify(r,null,2)))\"",
    "maintenance:smart-reindex": "node -e \"require('./src/maintenance/reindex').runSmartReindex({dryRun:true}).then(r=>console.log(JSON.stringify(r,null,2)))\"",
    "maintenance:unused-indexes": "node -e \"require('./src/maintenance/reindex').getUnusedIndexes().then(r=>console.log(JSON.stringify(r,null,2)))\"",
    "maintenance:fill-factors": "node scripts/apply-fill-factors.js",
    "maintenance:fill-factors-reindex": "node scripts/apply-fill-factors.js --reindex",
    "maintenance:cluster": "node -e \"require('./src/maintenance/cluster').runMonthlyCluster({dryRun:true}).then(r=>console.log(JSON.stringify(r,null,2)))\"",
    "maintenance:cluster-status": "node -e \"require('./src/maintenance/cluster').getClusterStatus().then(r=>console.log(JSON.stringify(r,null,2)))\"",
    "maintenance:analyze": "node -e \"require('./src/maintenance/analyze').runFullAnalyze().then(r=>console.log(JSON.stringify(r,null,2)))\"",
    "maintenance:stale-stats": "node -e \"require('./src/maintenance/analyze').getStaleStats().then(r=>console.log(JSON.stringify(r,null,2)))\"",
    "maintenance:apply-statistics": "node scripts/apply-statistics.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@sendgrid/mail": "^8.1.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "twilio": "^6.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2"
  }
}
