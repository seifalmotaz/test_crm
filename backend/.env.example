# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/propcrm?schema=public"

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_jwt_secret_here_64_chars_minimum
JWT_REFRESH_SECRET=your_refresh_secret_here_64_chars_minimum
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Server
# 5001 instead of the conventional 5000 — Docker Desktop occupies 5000 on Windows.
PORT=5001
NODE_ENV=development

# CORS – comma-separated list of allowed frontend origins; replace with your production domain(s) before deploying
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

# Seed — password assigned to all users created by `npm run seed`.
# If unset, a random 32-char hex password is generated and printed to stdout.
# Set this for repeatable staging environments where you need a known password.
# SEED_PASSWORD=replace_with_a_strong_password

# Email (SendGrid) — set both to enable email delivery
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=noreply@yourdomain.com
