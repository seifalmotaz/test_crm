# ─────────────────────────────────────────────────────
# Estate CRM - Environment Variables
# ─────────────────────────────────────────────────────
# Set these in your Dokploy environment (or .env for local Docker Compose)
# ─────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════
# App
# ═══════════════════════════════════════════════════
NODE_ENV=production
PORT=3000

# The frontend URL for CORS. In production this must be the exact domain
# of your web service. Example: https://app.yourdomain.com
CORS_ORIGIN=https://your-frontend-domain.com

# The actual domain your cookies are served from.
# If frontend and API share a root domain, set this to that root domain
# (e.g., ".yourdomain.com"). If they are on completely different domains,
# cookies will NOT work—use the same root domain or a custom subdomain.
COOKIE_DOMAIN=.yourdomain.com

# ═══════════════════════════════════════════════════
# Frontend
# ═══════════════════════════════════════════════════
# The API base URL the SPA will call. In Dokploy set this to your app's
# public domain (e.g., https://api.yourdomain.com). Leave empty if API
# and frontend are served on the same domain (relative requests).
VITE_API_URL=https://your-api-domain.com

# ═══════════════════════════════════════════════════
# Database (PostgreSQL)
# ═══════════════════════════════════════════════════
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-very-strong-db-password
POSTGRES_DB=estate_crm
# (Optional) DATABASE_URL_TEST is only needed for test runs
DATABASE_URL_TEST=

# ═══════════════════════════════════════════════════
# Redis
# ═══════════════════════════════════════════════════
# (No extra envs needed — wired automatically in docker-compose.yml)

# ═══════════════════════════════════════════════════
# JWT Keys
# ═══════════════════════════════════════════════════
# Generate with: scripts/generate-jwt-keys.sh
# Must be single-line PEM (replace actual newlines with \n)
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIJJwIBAAKCAgEAx...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIICIjANBgkqhkiG9w0BAQEFAAOCAg8AMIICCgKCAgEAy...\n-----END PUBLIC KEY-----"

# ═══════════════════════════════════════════════════
# S3 / MinIO
# ═══════════════════════════════════════════════════
# These point at the bundled MinIO by default in docker-compose.yml.
# If you switch to real AWS S3, change S3_ENDPOINT, S3_ACCESS_KEY, S3_SECRET_KEY.
S3_BUCKET=estate-crm
S3_REGION=us-east-1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://minio:9000
MINIO_BROWSER=on
