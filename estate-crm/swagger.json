  "info": {
    "title": "Estate CRM API",
    "description": "Multi-tenant CRM for real estate brokerage organizations",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "access_token"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "agent@example.com",
            "description": "User email address"
          },
          "password": {
            "type": "string",
            "example": "SecurePass123!",
            "minLength": 8,
            "description": "User password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "01915d5e-8c1f-7d3a-a5e6-b8c9d0e1f2a3"
          },
          "email": {
            "type": "string",
            "example": "agent@example.com"
          },
          "name": {
            "type": "string",
            "example": "John Smith"
          },
          "role": {
            "type": "string",
            "example": "agent",
            "enum": [
              "admin",
              "manager",
              "agent"
            ]
          },
          "tenantId": {
            "type": "string",
            "example": "01915d5e-8c1f-7d3a-a5e6-b8c9d0e1f2a3"
          },
          "tenantName": {
            "type": "string",
            "example": "Sunset Realty"
          },
          "status": {
            "type": "string",
            "example": "active",
            "enum": [
              "active",
              "inactive",
              "suspended"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role",
          "tenantId",
          "tenantName",
          "status"
        ]
      },
      "ProblemDetailsDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "https://errors.estate-crm.com/validation_error"
          },
          "title": {
            "type": "string",
            "example": "Bad Request"
          },
          "status": {
            "type": "number",
            "example": 400
          },
          "code": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "detail": {
            "type": "string",
