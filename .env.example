# Copy this file to .env and fill in real values before running docker compose up.
# Never commit the real .env — it is listed in .gitignore.

# ── PostgreSQL (used by docker-compose.yml for the postgres container) ─────────
# Must match the password embedded in backend/.env DATABASE_URL.
# Generate a strong password: openssl rand -base64 32
DB_PASSWORD=changeme_use_a_strong_random_password

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Use different values for JWT_SECRET and JWT_REFRESH_SECRET.
JWT_SECRET=replace_with_a_64_char_random_hex_string
JWT_REFRESH_SECRET=replace_with_a_different_64_char_random_hex_string

# How long access tokens are valid (e.g. 15m, 1h, 24h)
JWT_EXPIRES_IN=24h

# How long refresh tokens are valid (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# ── Backend runtime ───────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins. Set to your production domain(s).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Maximum upload size in megabytes (docker-compose default: 10)
MAX_FILE_SIZE_MB=10

# Upload directory inside the container — override only if you change the volume mount path
UPLOAD_DIR=/app/uploads

# ── Vite frontend (optional) ──────────────────────────────────────────────────
# Overrides the dev-server proxy target for /api and /uploads routes.
# Defaults to http://localhost:5001 when unset. Set this if your backend runs
# on a different host or port (e.g. inside Docker with a custom port mapping).
# VITE_API_TARGET=http://localhost:5001

# One-click demo login shown on the login page in local development only.
# Gated behind import.meta.env.DEV — never compiled into production builds.
# Set these in .env.local (which is git-ignored); do NOT set them in .env.
# VITE_DEMO_EMAIL=demo@example.com
# VITE_DEMO_PASSWORD=changeme
